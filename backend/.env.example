PORT=4000
FRONTEND_URL=http://localhost:3000
# Optional: comma-separated extra origins (preview URLs, custom domains)
# ALLOWED_ORIGINS=https://staging.example.com
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=billing
# Generate a unique secret: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-random-secret-at-least-32-chars
# Google OAuth — same Client ID as frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# OTP email (optional in dev — OTP prints in backend terminal if Resend fails or is unset)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Billing Studio <onboarding@resend.dev>"
# Resend test sender only delivers to your Resend account email until you verify a domain.
# OTP_FORCE_CONSOLE=true
