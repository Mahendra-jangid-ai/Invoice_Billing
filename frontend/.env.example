# Must match backend SESSION_SECRET exactly
# Generate a unique secret: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-random-secret-at-least-32-chars
BACKEND_URL=http://localhost:4000
# Google Sign-In (Web client) — must match backend GOOGLE_CLIENT_ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
